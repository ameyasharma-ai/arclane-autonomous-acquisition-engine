{
    "scraper": {
        "max_review_scrolls": 50,
        "max_reviews_extracted": 300,
        "llm_api_timeout_seconds": 180,
        "page_load_timeout_ms": 90000,
        "element_wait_timeout_ms": 15000,
        "gspread_max_retries": 5,
        "feed_scroll_limit": 300
    },
    "runner": {
        "default_chunk_size": 50,
        "default_target_leads": 1500,
        "crash_cooldown_seconds": 10,
        "ram_reclaim_sleep_seconds": 3
    },
    "telegram_bot": {
        "agent_smith_history_limit": 5,
        "agent_smith_timeout_seconds": 180
    },
    "llm": {
        "provider_mode": "default",
        "primary_provider": "gemini",
        "primary_model": "gemini-flash-lite-latest",
        "gemini_keys_env": [
            "GEMINI_REVIEWS_API_KEY",
            "GEMINI_REVIEWS_CLEANER_KEY"
        ],
        "openrouter_keys_env": [
            "OPENROUTER_API_KEY",
            "OPENROUTER_API_KEY_AGENT_SMITH",
            "OPENROUTER_API_KEY_CLEANER"
        ],
        "fallback_models": [
            "nvidia/nemotron-3-ultra-550b-a55b:free",
            "particle-ai/particle-1:free",
            "baidu/ernie-5.5-flash-preview:free",
            "cohere/north-mini-code:free",
            "inclusionai/ling-3.2-flash:free",
            "nvidia/nemotron-3.5-super-vl:free",
            "liquid/lfm-3-1.7b:free",
            "google/gemma-4-31b-it:free",
            "openrouter/free"
        ]
    }
}