# ==============================================================================
# ArcLane Autonomous Acquisition Engine Configuration Template
# ==============================================================================

# Master Pipeline Safety & Governance Controls
DRY_RUN=true                      # Set to false for live production outreach
HUMAN_APPROVAL_REQUIRED=true      # Enforces human review before outbound dispatch
EMERGENCY_STOP=false              # Set to true to instantly halt all outbound sending

# Telegram Bot Tokens
TELEGRAM_BOT_TOKEN="your_nodejs_scraper_bot_token"
CONTROLLER_BOT_TOKEN="your_controller_bot_token"
TELEGRAM_SALES_BOT_TOKEN="your_python_sales_bot_token"

# AI Inference (Gemini & OpenRouter Fallback)
API="your_gemini_api_key"
OPENROUTER_API_KEY="your_openrouter_api_key"

# Google Sheets CRM
SPREADSHEET_NAME="Your Google Sheet Name"
WORKSHEET_NAME="Sheet1"
SERVICE_ACCOUNT_FILE="service_account.json"

# Email Outreach (SMTP)
GMAIL_ADDRESS="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_google_app_password"

# Vercel Deployment (Optional if logged in via `npx vercel login`)
VERCEL_TOKEN="your_vercel_token_optional"

# Server & Timezone Settings
PORT=3000
TIMEZONE="Asia/Kolkata"
